# Runtime app database (used by drizzle-kit and the migrate script)
DATABASE_URL=postgres://geopolitik:geopolitik@localhost:5432/geopolitik

# Worldgen database (PostGIS-enabled; same container, separate DB)
POSTGIS_URL=postgres://geopolitik:geopolitik@localhost:5432/geopolitik_worldgen

# Postgres connection parts (in case any tool wants them split out)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=geopolitik
POSTGRES_PASSWORD=geopolitik
POSTGRES_DB=geopolitik

# Redis
REDIS_URL=redis://localhost:6379

# Mailpit (SMTP catcher for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@geopolitik.io
