# Local dev infrastructure (consumed by docker-compose and apps).
# Copy to .env (gitignored) and tweak per machine if needed.

# Postgres (single container locally; see docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=geopolitik
POSTGRES_PASSWORD=geopolitik
POSTGRES_DB=geopolitik

# Redis
REDIS_URL=redis://localhost:6379

# Mailpit (SMTP catcher for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@geopolitik.io
