{
	"name": "@geopolitik/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./schema": "./src/schema/index.ts",
		"./client": "./src/client.ts"
	},
	"scripts": {
		"db:generate": "bun --env-file=../../.env x drizzle-kit generate",
		"db:migrate": "bun --env-file=../../.env run src/migrate.ts",
		"db:studio": "bun --env-file=../../.env x drizzle-kit studio",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"drizzle-orm": "0.36.4",
		"postgres": "3.4.5",
		"uuid": "11.0.3"
	},
	"devDependencies": {
		"@geopolitik/config": "*",
		"@types/uuid": "10.0.0",
		"drizzle-kit": "0.28.1",
		"typescript": "5.6.3"
	}
}
