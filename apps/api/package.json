{
	"name": "@geopolitik/api",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --hot run src/server.ts",
		"build": "bun build src/server.ts --target=bun --outdir=dist --minify",
		"start": "bun run dist/server.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist .turbo"
	},
	"dependencies": {
		"@geopolitik/db": "*",
		"@geopolitik/shared": "*",
		"better-auth": "1.1.4",
		"hono": "4.6.10",
		"pino": "9.5.0",
		"pino-pretty": "13.0.0",
		"zod": "3.23.8"
	},
	"devDependencies": {
		"@geopolitik/config": "*",
		"@types/bun": "1.1.13",
		"typescript": "5.6.3",
		"vitest": "2.1.5"
	}
}
