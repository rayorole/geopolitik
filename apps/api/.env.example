# apps/api environment.
# Copy to apps/api/.env.local (gitignored) and fill in.

NODE_ENV=development
API_PORT=3001

# Cookies / auth — must match apps/web origin in dev.
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
# Generate a 32+ char random string. e.g. `openssl rand -hex 32` or `bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"`
BETTER_AUTH_SECRET=replace_me_with_long_random_string

# Database (matches docker-compose Postgres)
DATABASE_URL=postgres://geopolitik:geopolitik@localhost:5432/geopolitik

# Redis (queues, rate limiting; not used heavily at Phase 0)
REDIS_URL=redis://localhost:6379

# Discord OAuth — create app at https://discord.com/developers/applications
# Redirect URI to add: http://localhost:3001/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Logging
LOG_LEVEL=debug
